# Backend environment variables — copy to backend/.env and set real values.
# NEVER commit backend/.env to git.

# MongoDB (admin accounts, login attempt tracking)
MONGO_URL=mongodb://localhost:27017
DB_NAME=test_database

# Allowed browser origin for CORS (the site URL that calls the API)
CORS_ORIGINS=*
FRONTEND_URL=https://your-site-domain.example.com

# Auth
JWT_SECRET=change-me-to-a-64-char-random-hex
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Email notifications (Emergent managed Resend integration)
EMERGENT_EMAIL_KEY=provided-by-your-emergent-integration
EMAIL_FROM_NAME=IMMUTA Technologies
EMAIL_REPLY_TO=owner-inbox@example.com
OWNER_EMAIL=owner-inbox@example.com

# --- Supabase (OPTIONAL - intentionally left disconnected) ---
# The app ships with Supabase support but it is NOT configured by default.
# Leave both lines commented/absent to keep Supabase disconnected:
# enquiry submissions will then return HTTP 503 and nothing is stored.
# Only fill these in if you decide to enable hosted enquiry storage later.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-publishable-anon-key
# SUPABASE_DB_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?connect_timeout=8&statement_cache_size=0
