# Frontend environment variables (CRA — values are baked in at build time)
# Copy to frontend/.env and set real values BEFORE running the production build.

# Public base URL of the backend API (no trailing slash).
#
# Option A (recommended, single Hostinger Node app): leave the value EMPTY —
#   REACT_APP_BACKEND_URL=
# The Node backend serves both the site and the API on the same origin.
#
# Option B (split hosting): point it at wherever the FastAPI backend runs.
REACT_APP_BACKEND_URL=
