# Frontend environment variables (CRA — values are baked in at build time)
# Copy to frontend/.env and set real values BEFORE running the production build.

# Public base URL of the backend API (no trailing slash).
# For Hostinger static hosting, point this at wherever the FastAPI backend runs
# (see README "Backend hosting" — Hostinger Cloud Node plans cannot host Python).
REACT_APP_BACKEND_URL=https://your-api-domain.example.com
