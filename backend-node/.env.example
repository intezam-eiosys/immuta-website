# Node backend environment (Hostinger: set these in the app's Environment variables panel)
# NEVER commit .env to git.

NODE_ENV=production
PORT=8001

# Auth — generate the hash for your chosen password:
#   node -e "const b=require('bcryptjs');console.log(b.hashSync(process.argv[1],12))" 'your-password'
JWT_SECRET=change-me-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace-with-bcrypt-hash
JWT_TTL=8h

# External Supabase connection (Dashboard -> Connect -> Transaction pooler, port 6543)
SUPABASE_DB_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Email notifications (Emergent managed Resend integration)
EMERGENT_EMAIL_KEY=provided-by-your-emergent-integration
EMAIL_FROM_NAME=IMMUTA Technologies
EMAIL_REPLY_TO=owner-inbox@example.com
OWNER_EMAIL=owner-inbox@example.com

# Optional: only needed if the frontend is hosted on a different origin
FRONTEND_URL=
